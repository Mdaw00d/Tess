# Supabase PostgreSQL transaction pooler URL (server-only; never prefix NEXT_PUBLIC_).
# Without this value the library uses local example definitions.
SUPABASE_DATABASE_URL=

# Public Supabase project URL (safe to expose to browser clients).
NEXT_PUBLIC_SUPABASE_URL=https://fmkdoyyqxwpuvwqgddcq.supabase.co

# Google sign-in (server-only credentials).
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only admin allowlist; use your verified Google sign-in email.
TESS_ADMIN_EMAILS=

# Server-only transactional email. Sender must use a Resend-verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public PostHog project setup values, not a personal API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
