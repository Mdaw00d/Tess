{
  "name": "tess",
  "version": "1.0.0",
  "description": "Tess: reusable agent skills and loops",
  "main": "index.js",
  "scripts": {
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "dev": "next dev --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "eval:grade": "node evaluations/grade.mjs",
    "test:eval": "node --test evaluations/grade.test.mjs evaluations/verify.test.mjs",
    "eval:record": "node evaluations/record.mjs",
    "test:db": "tsx db/check.ts",
    "test:auth": "tsx db/check-auth.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
